# Development environment variables
VITE_API_URL=http://localhost:8000
VITE_SIMULATE_FAILURE=false
VITE_SEED_MOCK_DATA=false

# Satellite mode: default to MOCK_NDVI=true for local dev/demo without requiring Copernicus credentials
MOCK_NDVI=true

# Sepolia testnet defaults
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x815F9122D29471e161D66068Eef9a508EC079442

# Supabase Cloud Integration (uncomment and add your credentials)
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

