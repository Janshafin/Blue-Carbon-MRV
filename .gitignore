# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
dev-dist/

# Cloned repo (if present inside workspace)
Blue-Carbon-MRV/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.DS_Store
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# PWA generated files (regenerated on build)
public/sw.js
public/workbox-*.js

# Python cache & testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local database & uploaded assets
data/*.db
storage/photos/*
storage/evidence/*
!data/.gitkeep
!storage/photos/.gitkeep
!storage/evidence/.gitkeep
