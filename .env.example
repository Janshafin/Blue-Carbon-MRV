# ===========================================
# Blue Carbon MRV — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ===========================================

# Sepolia testnet RPC endpoint (Alchemy, Infura, or public)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Private key of the deployer wallet (without 0x prefix is fine too)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Copernicus Data Space Ecosystem OAuth credentials for the NDVI service.
# Create these in the Sentinel Hub dashboard; never commit the real values.
COPERNICUS_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID
COPERNICUS_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET

# Backend-only persistence credentials. SUPABASE_SERVICE_ROLE_KEY and PINATA_JWT
# must never be exposed through VITE_ variables or committed to Git.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PINATA_JWT=YOUR_PINATA_JWT

# NDVI scorer used by the backend and allowed browser origins.
CORE_ENGINE_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:5173
