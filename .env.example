# ==============================================================================
# Blue Carbon MRV — Comprehensive Environment Configuration
# ==============================================================================
# Copy this file to .env and configure real credentials.
# NEVER commit your real .env file or private keys to version control.
# ==============================================================================

# ─── 1. Backend Server & Database ─────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///data/blue_carbon.db

# ─── 2. Satellite Provider & NDVI Engine ──────────────────────────────────────
# Set MOCK_NDVI=true for local offline development / hackathon demos.
# Set MOCK_NDVI=false to require live Copernicus Sentinel-2 CDSE credentials.
MOCK_NDVI=true
SATELLITE_PROVIDER=copernicus_sentinel2

# Copernicus Data Space Ecosystem (CDSE) credentials:
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID
COPERNICUS_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET

# ─── 3. Ethereum Sepolia Blockchain & Smart Contract ──────────────────────────
# Sepolia Testnet RPC URL (e.g. Infura, Alchemy, or public endpoint)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111

# Deployed BlueCarbonCredit ERC-20 contract on Sepolia
CONTRACT_ADDRESS=0x815F9122D29471e161D66068Eef9a508EC079442
BLUE_CARBON_CREDIT_ADDRESS=0x815F9122D29471e161D66068Eef9a508EC079442

# Private key of the verifier wallet granted VERIFIER_ROLE
# WARNING: NEVER expose or commit this key. The backend signs transactions server-side.
VERIFIER_PRIVATE_KEY=0xYOUR_VERIFIER_PRIVATE_KEY_HERE
PRIVATE_KEY=0xYOUR_VERIFIER_PRIVATE_KEY_HERE

# Optional Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ─── 4. Frontend Configuration ────────────────────────────────────────────────
# API base URL consumed by Vite React client
VITE_API_URL=http://localhost:8000
VITE_SIMULATE_FAILURE=false
VITE_SEED_MOCK_DATA=false

# ─── 5. Supabase Cloud Integration (Database & Storage) ───────────────────────
# Create project at: https://supabase.com
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Frontend Supabase Access (optional)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

